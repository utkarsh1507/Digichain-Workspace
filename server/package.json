{
  "name": "digichain-workspace-server",
  "version": "1.0.0",
  "type": "commonjs",
  "scripts": {
    "build": "prisma generate",
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "db:push": "prisma db push",
    "db:seed": "node src/seed.js",
    "db:studio": "prisma studio",
    "setup": "npm install && npx prisma db push && node src/seed.js",
    "db:backup": "powershell -ExecutionPolicy Bypass -File scripts/backup-postgres.ps1",
    "db:restore": "powershell -ExecutionPolicy Bypass -File scripts/restore-postgres.ps1"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.41.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "multer-storage-cloudinary": "^4.0.0",
    "googleapis": "^144.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.7",
    "prisma": "^5.22.0"
  }
}
