DATABASE_URL="postgres://username:password@db.prisma.io:5432/postgres?sslmode=require"
JWT_SECRET="replace-with-a-long-random-secret"
PORT=3001
CLIENT_URL="http://localhost:5174,https://your-app.vercel.app"
